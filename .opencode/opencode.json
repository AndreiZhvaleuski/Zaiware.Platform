{
  "$schema": "https://opencode.ai/config.json",
  "skills": [
    "https://raw.githubusercontent.com/microsoft/aspire-skills/e529b608336cd41c1b1262aa76d00d9e4ef1bff8/opencode/v2/"
  ],
  "mcp": {
    "servers": {
      "nuget": {
        "type": "local",
        "command": ["dnx", "NuGet.Mcp.Server", "--source", "https://api.nuget.org/v3/index.json", "--yes"],
        "timeout": { "startup": 120000 }
      },
      "duende-mcp": {
        "type": "local",
        "command": ["dnx", "Duende.Documentation.Mcp", "--yes", "--"],
        "cwd": "~/.local/share/opencode/duende-mcp",
        "timeout": { "startup": 120000 }
      },
      "microsoft-learn": {
        "type": "remote",
        "url": "https://learn.microsoft.com/api/mcp"
      }
    }
  },
  "providers": {
    "opencode-go": {
      "env": [
        "OPENCODE_API_KEY"
      ]
    }
  }
}
