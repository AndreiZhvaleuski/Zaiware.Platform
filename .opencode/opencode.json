{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "nuget": {
        "type": "local",
        "command": ["dnx", "NuGet.Mcp.Server", "--source", "https://api.nuget.org/v3/index.json", "--yes"],
        "timeout": { "startup": 120000 }
      },
      "duende-mcp": {
        "type": "local",
        "command": ["dnx", "Duende.Documentation.Mcp", "--yes", "--"],
        "cwd": "~/.local/share/opencode/duende-mcp",
        "timeout": { "startup": 120000 }
      }
    }
  },
  "providers": {
    "opencode-go": {
      "env": [
        "OPENCODE_API_KEY"
      ]
    }
  }
}
