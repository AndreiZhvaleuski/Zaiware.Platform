<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark">
  <title>@ViewData["Title"] · Nimbus</title>
  <link rel="stylesheet" href="~/css/site.css">
  <script src="~/js/otp.js" defer></script>
</head>
<body>
  <div class="scene" aria-hidden="true"><span class="grain"></span></div>

  <main class="shell">
    <section class="card" data-od-id="login-card" aria-labelledby="title">
      <div class="content">
        <header class="brand">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 18V6l12 12V6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="brand-name">Nimbus</span>
        </header>

        <p class="sr-only" id="status" role="status" aria-live="polite"></p>

        @RenderBody()
      </div>
    </section>
    <p class="legal">By continuing you agree to the Terms and Privacy Policy.</p>
  </main>
</body>
</html>
