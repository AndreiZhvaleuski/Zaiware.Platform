@page
@model Zaiware.Platform.IdentityServer.Pages.Account.EnterOtpModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Check your email";
}

<div class="card">
  <a class="back-link" asp-page="/Account/Login" asp-route-email="@Model.Email">&#8592; Change email</a>

  <header class="card__header">
    <h1 id="title" class="card__title" tabindex="-1" data-autofocus-heading>Check your email</h1>
    <p class="lead">Enter the 8-character code sent to <strong class="otp__email">@Model.Email</strong></p>
  </header>

  <p class="field__hint" id="otp-hint">Codes are single-use and expire in 5 minutes. It may take up to a minute to arrive.</p>

  <form id="otp-form" method="post" asp-page="/Account/EnterOtp" data-busy-form novalidate>
    <input type="hidden" asp-for="Input.Token">
    <fieldset class="code-inputs code-inputs--8" data-code-group data-code-pattern="alnum" aria-describedby="otp-hint otp-error">
      <legend class="visually-hidden">One-time code, 8 characters</legend>
      @for (var index = 0; index < 8; index++)
      {
        <input name="Input.CodeDigits[@index]"
               value="@Model.CodeDigit(index)"
               inputmode="text"
               autocomplete="@(index == 0 ? "one-time-code" : "off")"
               maxlength="1"
               aria-label="Character @(index + 1) of 8"
               autocapitalize="characters"
               spellcheck="false"
               data-code-digit>
      }
    </fieldset>
    <span class="field__error" id="otp-error" role="alert" aria-live="polite" asp-validation-for="Input.Code"></span>
    <div class="notice notice--error" role="alert" aria-live="polite" asp-validation-summary="ModelOnly"></div>
    @if (!string.IsNullOrEmpty(Model.ResendNotice))
    {
      <p class="field__error" role="alert" aria-live="polite">@Model.ResendNotice</p>
    }
    <div class="stack otp__submit">
      <button class="btn btn--primary btn--block" type="submit" id="verify-btn">
        <span>Verify</span><span class="btn__spinner" aria-hidden="true"></span>
      </button>
    </div>
  </form>

  <form method="post" asp-page="/Account/EnterOtp">
    <p class="otp__resend">Didn't get it?
      <button type="submit" id="resend" asp-page-handler="Resend"
              data-blocked-until="@(Model.SendingBlockedUntilUtc?.UtcDateTime.ToString("O"))"
              data-default-label="Resend code">Resend code</button>
    </p>
  </form>
</div>
