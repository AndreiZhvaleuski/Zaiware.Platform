@page
@model Zaiware.Platform.IdentityServer.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign in";
}

<div class="step" id="step-email">
  <h1 id="title" tabindex="-1">Sign in</h1>
  <p class="sub">We'll email you a one-time code.</p>
  <p class="hint-text" id="email-hint">No password needed — the code expires in 5 minutes.</p>
  @if (Model.SessionExpired)
  {
    <div class="notice" role="alert">Your sign-in session expired or a required browser cookie was blocked. Please request a new code.</div>
  }
  <form id="email-form" method="post" asp-page="/Account/Login" novalidate>
    <label asp-for="Input.Email">Work email</label>
    <input asp-for="Input.Email" id="email" type="email" inputmode="email"
           autocomplete="email" placeholder="you@company.com"
           required aria-describedby="email-hint email-error"
           aria-invalid="@(ViewData.ModelState["Input.Email"]?.Errors.Count > 0 ? "true" : "false")">
    <span class="error" id="email-error" role="alert" aria-live="polite" asp-validation-for="Input.Email"></span>
    <div class="error" role="alert" aria-live="polite" asp-validation-summary="ModelOnly"></div>
    <button class="btn" type="submit" id="send-btn">
      <span class="label">Send code</span><span class="spinner" aria-hidden="true"></span>
    </button>
  </form>
</div>
