@page
@model Zaiware.Platform.IdentityServer.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Signed in";
}

<div class="card signed-in">
  <div class="signed-in__badge" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </div>
  <header class="card__header">
    <h1 id="title" class="card__title" tabindex="-1">You're in</h1>
    <p class="lead">Signed in as <strong id="email-done">@Model.Email</strong></p>
  </header>
  <div class="stack">
    <a class="btn btn--primary btn--block" asp-page="/Account/Account">Manage account</a>
    <form method="post" asp-page="/Account/Logout">
      <button class="btn btn--secondary btn--block" type="submit" id="signout-btn">Sign out</button>
    </form>
  </div>
</div>
